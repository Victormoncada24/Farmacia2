# Copie este archivo como .env (desarrollo) o /opt/farmacia/.env (servidor).
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Nombre que se muestra en la plataforma (opcional)
# APP_NOMBRE=Simulador de Farmacia Asistencial
# APP_SUBTITULO=Plataforma de simulación académica · INACAP

# Clave Fernet para cifrar datos sensibles. ¡RESPÁLDELA! Sin ella no se pueden descifrar los datos.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Base de datos: sqlite (por defecto) o postgres ---
DB_ENGINE=postgres
DB_NAME=farmacia
DB_USER=farmacia
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# En AWS RDS use: require
DB_SSLMODE=prefer

# --- Producción (AWS) ---
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=farmacia.midominio.cl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://farmacia.midominio.cl
# DJANGO_DETRAS_DE_PROXY=True
# DJANGO_HTTPS=True

# --- Recetas escaneadas en S3 (opcional; bucket privado + rol IAM en la EC2) ---
# AWS_STORAGE_BUCKET_NAME=mi-bucket-farmacia-recetas
# AWS_S3_REGION_NAME=sa-east-1

# --- Integración bajo un subdirectorio (opcional) ---
# DJANGO_SCRIPT_NAME=/farmacia
# DJANGO_STATIC_URL=/farmacia/static/
